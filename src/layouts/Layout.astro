---
import '../styles/global.css';
import logoSvg from '../assets/logo.svg?raw';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isTagsSection = pathname === '/tags' || pathname.startsWith('/tags/');
const year = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/icon-192.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#bb5f00" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<script is:inline>
			// Runs before first paint to avoid a light/dark flash.
			(function () {
				let stored = null;
				try {
					stored = localStorage.getItem('theme');
				} catch {
					// Storage access can throw (private-browsing edge cases, embedded
					// contexts) — fall back to just the system preference.
				}
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (stored === 'dark' || (!stored && prefersDark)) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
	</head>
	<body>
		<div class="body-container">
			<header class="site-header">
				<div class="site-header-content">
					<a href="/" class="site-brand">
						<span class="site-logo" set:html={logoSvg} />
						<span class="site-brand-name">Book Keeper</span>
					</a>
					<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
						<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
						</svg>
						<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</button>
				</div>
			</header>
			<main class="body-content">
				<slot />
			</main>
			<footer class="site-footer">
				<div class="site-footer-container">
					<div class="footer-brand">
						<span class="footer-brand-name">Book Keeper</span>
						<p class="footer-copyright">© {year} Book Keeper</p>
					</div>
					<nav class="footer-nav">
						<a href="/" class={isHome ? 'footer-nav-active' : ''}>Home</a>
						<a href="/tags" class={isTagsSection ? 'footer-nav-active' : ''}>Tags</a>
					</nav>
				</div>
			</footer>
		</div>
		<script>
			const toggle = document.getElementById('theme-toggle');
			toggle?.addEventListener('click', () => {
				const isDark = document.documentElement.classList.toggle('dark');
				try {
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				} catch {
					// Storage access can throw — the toggle still works for this
					// visit, it just won't persist across reloads.
				}
			});
		</script>
	</body>
</html>
