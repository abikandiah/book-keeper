---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Badge } from '@abumble/design-system/components/Badge';
import Layout from '../../layouts/Layout.astro';
import { ChapterBlock } from '../../components/ChapterBlock';
import { CoverPlaceholder } from '../../components/CoverPlaceholder';
import { TagPill } from '../../components/TagPill';
import { coverUrl } from '../../lib/covers';

export async function getStaticPaths() {
	const books = await getCollection('books');
	return books.map((book) => ({
		params: { slug: book.id },
		props: { book },
	}));
}

interface Props {
	book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { title, author, year, isbn, tags, verified, one_line_takeaway, synopsis, chapters, key_claims_for_review } =
	book.data;
const cover = coverUrl(isbn, 'L');
const paragraphs = synopsis.split(/\n\n+/);
---

<Layout title={`${title} — Book Keeper`} description={one_line_takeaway}>
	<article class="content-page">
		<header class="article-header book-header">
			{cover ? (
				<img src={cover} alt={`Cover of ${title}`} class="book-cover-lg" width={100} height={150} />
			) : (
				<CoverPlaceholder size="lg" />
			)}
			<div>
				<h1 class="article-title">{title}</h1>
				<div class="article-byline">
					<span class="article-meta">
						<span>{author}</span>
						{year && <span>{year}</span>}
						{verified && (
							<Badge variant="success" className="verified-badge">
								Verified
							</Badge>
						)}
					</span>
					<div class="article-tags">
						{tags.map((tag) => <TagPill tag={tag} />)}
					</div>
					<p class="book-takeaway">{one_line_takeaway}</p>
				</div>
			</div>
		</header>

		<div class="prose">
			{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		<a href={`/review/${book.id}`} class="review-banner">
			<span>Test yourself on {key_claims_for_review.length} key claim{key_claims_for_review.length === 1 ? '' : 's'}</span>
			<span class="review-banner-arrow">→</span>
		</a>

		<details class="key-claims-section">
			<summary class="section-label collapsible-summary">Key Claims ({key_claims_for_review.length})</summary>
			<div class="key-claims">
				{key_claims_for_review.map((claim) => (
					<div class="key-claim">
						<p class="key-claim-prompt">{claim.prompt}</p>
						<p class="key-claim-answer">{claim.answer}</p>
					</div>
				))}
			</div>
		</details>

		<div class="chapters">
			{chapters.map((chapter) => <ChapterBlock chapter={chapter} />)}
		</div>
	</article>
</Layout>
