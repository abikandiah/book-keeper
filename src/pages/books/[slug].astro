---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Badge } from '@abumble/design-system/components/Badge';
import Layout from '../../layouts/Layout.astro';
import { ChapterBlock } from '../../components/ChapterBlock';
import { CoverPlaceholder } from '../../components/CoverPlaceholder';
import { TagPill } from '../../components/TagPill';
import { coverUrl } from '../../lib/covers';

export async function getStaticPaths() {
	const books = await getCollection('books');
	return books.map((book) => ({
		params: { slug: book.id },
		props: { book },
	}));
}

interface Props {
	book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { title, author, year, isbn, page_count, tags, verified, one_line_takeaway, synopsis } = book.data;
const cover = coverUrl(isbn, 'L');
const paragraphs = synopsis.split(/\n\n+/);
// `chapters`/`key_claims_for_review` only exist on the non-fiction branch of
// the schema (see src/content/schema.ts) — narrowed once here rather than
// re-checking `book.data.kind === 'non-fiction'` at each of the three
// sections below (narrowing a separately-destructured `kind` local wouldn't
// narrow `book.data` itself, so this has to be its own variable).
const nonFiction = book.data.kind === 'non-fiction' ? book.data : undefined;
---

<Layout title={`${title} — Book Keeper`} description={one_line_takeaway}>
	<article class="content-page">
		<header class="article-header book-header">
			{cover ? (
				<img src={cover} alt={`Cover of ${title}`} class="book-cover-lg" width={100} height={150} />
			) : (
				<CoverPlaceholder size="lg" />
			)}
			<div>
				<h1 class="article-title">{title}</h1>
				<div class="article-byline">
					<span class="article-meta">
						<span>{author}</span>
						{year && <span>{year}</span>}
						{page_count != null && <span>{page_count} pages</span>}
						{verified && (
							<Badge variant="success" className="verified-badge">
								Verified
							</Badge>
						)}
					</span>
					<div class="article-tags">
						{tags.map((tag) => <TagPill tag={tag} />)}
					</div>
					<p class="book-takeaway">{one_line_takeaway}</p>
				</div>
			</div>
		</header>

		<div class="prose">
			{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		{nonFiction && (
			<Fragment>
				{nonFiction.key_claims_for_review.length > 0 && (
					<a href={`/review/${book.id}`} class="review-banner">
						<span>
							Test yourself on {nonFiction.key_claims_for_review.length} key claim
							{nonFiction.key_claims_for_review.length === 1 ? '' : 's'}
						</span>
						<span class="review-banner-arrow">→</span>
					</a>
				)}

				<details class="key-claims-section">
					<summary class="section-label collapsible-summary">Key Claims ({nonFiction.key_claims_for_review.length})</summary>
					<div class="key-claims">
						{nonFiction.key_claims_for_review.map((claim) => (
							<div class="key-claim">
								<p class="key-claim-prompt">{claim.prompt}</p>
								<p class="key-claim-answer">{claim.answer}</p>
							</div>
						))}
					</div>
				</details>

				<div class="chapters">
					{nonFiction.chapters.map((chapter) => <ChapterBlock chapter={chapter} />)}
				</div>
			</Fragment>
		)}
	</article>
</Layout>
