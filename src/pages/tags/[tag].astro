---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { BookCard } from '../../components/BookCard';
import { sortByDateAddedDesc } from '../../lib/books';
import { formatTagLabel } from '../../lib/tags';

export async function getStaticPaths() {
	const books = await getCollection('books');

	// Single pass grouping books by tag (matches tags/index.astro's own
	// tag-counting pass) rather than re-scanning the whole book list once
	// per distinct tag — that per-tag filter was O(books × tags), which
	// only grows worse as both grow together.
	const byTag = new Map<string, CollectionEntry<'books'>[]>();
	for (const book of books) {
		for (const tag of book.data.tags) {
			const list = byTag.get(tag);
			if (list) list.push(book);
			else byTag.set(tag, [book]);
		}
	}

	return [...byTag.entries()].map(([tag, taggedBooks]) => ({
		params: { tag },
		props: { books: taggedBooks.sort(sortByDateAddedDesc) },
	}));
}

interface Props {
	books: CollectionEntry<'books'>[];
}

const { tag } = Astro.params;
const { books } = Astro.props;
const tagLabel = formatTagLabel(tag);
---

<Layout title={`${tagLabel} — Book Keeper`} description={`Books tagged “${tagLabel}”.`}>
	<div class="index-page">
		<div class="page-heading">
			<h1 class="page-heading-title">{tagLabel}</h1>
			<p class="page-heading-description">{books.length} book{books.length === 1 ? '' : 's'}</p>
		</div>
		<ul class="book-list">
			{books.map((book) => (
				<BookCard
					slug={book.id}
					title={book.data.title}
					author={book.data.author}
					year={book.data.year}
					isbn={book.data.isbn}
					tags={book.data.tags}
					oneLineTakeaway={book.data.one_line_takeaway}
					verified={book.data.verified}
				/>
			))}
		</ul>
	</div>
</Layout>
