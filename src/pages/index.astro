---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { BookCard } from '../components/BookCard';
import { sortByDateAddedDesc } from '../lib/books';

const books = (await getCollection('books')).sort(sortByDateAddedDesc);
---

<Layout
	title="Book Keeper"
	description="A personal library of books read, with chapter-by-chapter summaries and key claims for review."
>
	<div class="index-page">
		<h1 class="sr-only">Book Keeper</h1>
		<p class="index-lede">A running archive of what I've read — the refresher I come back to.</p>
		{
			books.length === 0 ? (
				<p class="collection-empty">No books yet.</p>
			) : (
				<ul class="book-list">
					{books.map((book) => (
						<BookCard
							slug={book.id}
							title={book.data.title}
							author={book.data.author}
							year={book.data.year}
							isbn={book.data.isbn}
							tags={book.data.tags}
							oneLineTakeaway={book.data.one_line_takeaway}
							verified={book.data.verified}
						/>
					))}
				</ul>
			)
		}
	</div>
</Layout>
