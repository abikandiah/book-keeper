# Model — via OpenRouter (supports Anthropic, OpenAI, Google, Mistral, etc.)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free

# Search — Google Custom Search JSON API (active provider). Free tier:
# 100 queries/day, and with no billing account attached to the Google Cloud
# project, going over just fails the request — there's no payment method on
# file for it to charge. Get GOOGLE_CSE_API_KEY from the Google Cloud
# Console (enable the "Custom Search API"); get GOOGLE_CSE_CX from
# https://programmablesearchengine.google.com/ after creating a search
# engine — IMPORTANT: turn on "Search the entire web" in its control panel,
# otherwise it only searches sites you've explicitly added.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Search — Tavily (scripts/search/tavily.ts). Kept as an alternate
# SearchProvider implementation but not currently instantiated — Tavily
# requires a credit card on file for its free tier. Switching back means
# editing the import/instantiation in scripts/generate-book.ts's main().
TAVILY_API_KEY=
