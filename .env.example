# Model — via OpenRouter (supports Anthropic, OpenAI, Google, Mistral, etc.)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free

# Search — Tavily (active provider). Free tier: 1,000 credits/month, no card.
TAVILY_API_KEY=

# Search — Google Custom Search JSON API. Alternate provider, not currently
# instantiated (see scripts/search/google-cse/).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
