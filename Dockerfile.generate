# Hardened, self-contained image for scripts/generate-book.ts's --emit-json
# path — see docs/blueprint/05-operations-and-future.md. Deliberately never
# COPYs the whole repo: .git, .env, and any host secrets simply don't exist
# in this image, not just "permission denied" to reach them. This container
# is invoked by scripts/generate-sandboxed.sh, which handles the actual git
# branch/commit step afterward, on the host.
FROM node:22-bookworm-slim

RUN useradd --create-home --uid 10001 sandboxuser

WORKDIR /app

# Installed before app code is copied in, so editing scripts/ doesn't
# invalidate this layer and force a full reinstall on every rebuild.
COPY package.json pnpm-lock.yaml ./
# Version pinned rather than corepack (which, with no "packageManager" field
# in package.json, would resolve whatever pnpm version corepack considers
# current at build time). package.json's "pnpm.onlyBuiltDependencies" is
# what actually lets --frozen-lockfile succeed non-interactively below:
# pnpm 10+ blocks dependency install/postinstall scripts by default, and
# esbuild's install script is needed for tsx to run at all.
RUN npm install -g pnpm@10 && pnpm install --frozen-lockfile

COPY tsconfig.json ./
COPY scripts/ ./scripts/
# generate-book.ts's only src/ dependency — schema.ts itself only imports
# zod, so the rest of src/ (the Astro site) has no reason to be in here.
COPY src/content/schema.ts ./src/content/schema.ts

# The container runs with --read-only rootfs (see generate-sandboxed.sh);
# sandboxuser's real home dir lives on that read-only layer, so anything
# that wants to write a cache/config file to $HOME needs somewhere writable
# to land instead — /tmp is the tmpfs generate-sandboxed.sh mounts in.
ENV HOME=/tmp
USER sandboxuser

ENTRYPOINT ["pnpm", "exec", "tsx", "scripts/generate-book.ts"]
